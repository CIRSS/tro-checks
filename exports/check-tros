#!/usr/bin/env bash
#
# Check every subject and write one report each.
#
#   check-tros <subjects-dir> <reports-dir>
#
# Exits non-zero only when the run could not be made -- an unmet expectation is
# a finding to report, not a failure of the run.

set -u

subjects=$1
reports=$2

if [ ! -d "${subjects}" ] ; then
    echo "no subjects directory at ${subjects}" >&2
    exit 1
fi

shopt -s nullglob
documents=( "${subjects}"/*.jsonld )
shopt -u nullglob

if [ ${#documents[@]} -eq 0 ] ; then
    echo "no subjects in ${subjects}" >&2
    exit 1
fi

mkdir -p "${reports}"

for document in "${documents[@]}" ; do
    name=$(basename "${document}" .jsonld)
    check-tro "${document}" "${reports}/${name}.md" || true
done
