{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://w3id.org/trace/tro/0.1/composition-fingerprint.schema.json",
    "title": "Composition fingerprint",
    "description": "The composition carries a fingerprint.",
    "type": "object",
    "properties": {
        "@graph": {
            "type": "array",
            "items": {
                "type": "object",
                "properties": {
                    "trov:hasComposition": {
                        "type": "object",
                        "required": ["trov:hasFingerprint"],
                        "errorMessage": {
                            "required": "the composition carries no trov:hasFingerprint"
                        }
                    }
                }
            }
        }
    }
}
