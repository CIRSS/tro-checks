repro.require json-schema-dev main ${CIRSS} --python --javascript

# Make the installed runners executable. repro.require's set_mode_bits sets the
# bit by mime type and knows shell and Python scripts; a Node script is neither,
# so it arrives unexecutable. ai-coding-dev does the same for its own reviews
# command. The command names beside these are symlinks the manifest creates.
chmod +x "$1/check-tro.js" "$1/check-tros.js"
